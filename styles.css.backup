/* Theme Park Crowd Report — Minimal Landing Page */

:root {
    --bg-dark: #0a1628;
    --bg-card: #111d33;
    --text-primary: #ffffff;
    --text-secondary: #b5bac1;
    --text-muted: #80848e;
    --accent: #00d4ff;
    --border: #1a2a44;
    
    /* Benedictus WTI Colors */
    --wti-low: rgb(10, 47, 143);        /* Deep blue */
    --wti-med-low: rgb(60, 120, 210);   /* Blue */
    --wti-medium: rgb(210, 200, 220);   /* Lavender */
    --wti-med-high: rgb(245, 140, 175); /* Pink */
    --wti-high: rgb(166, 0, 56);        /* Deep red */
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg-dark);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

/* Hero Section */
.hero {
    position: relative;
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    overflow: hidden;
}

.scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    animation: bounce 2s ease infinite;
    color: var(--text-muted);
    opacity: 0.6;
}

@keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
}

.hero-bg {
    position: absolute;
    inset: 0;
    background: 
        linear-gradient(180deg, rgba(10, 22, 40, 0.7) 0%, rgba(10, 22, 40, 0.85) 60%, var(--bg-dark) 100%),
        url('assets/twitch-profile-banner.jpg') center center / cover no-repeat;
    z-index: 0;
}

.hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
}

.hero h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--text-primary) 0%, #d2c8dc 50%, #ffb1c9 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-sub {
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1rem;
    line-height: 1.7;
}

.hero-credit {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-style: italic;
    margin-top: 1rem;
}

/* Chart Section */
.chart-section {
    padding: 6rem 2rem;
    background: var(--bg-dark);
    border-top: 1px solid var(--border);
}

.chart-container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
}

.chart-container h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 2.5rem;
    color: var(--text-primary);
}

.chart-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.5rem 1.5rem 2rem;
    margin-bottom: 1rem;
}

.wti-chart {
    display: flex;
    justify-content: center;
    align-items: end;
    gap: clamp(1rem, 5vw, 2rem);
    height: 240px;
    padding: 0 1rem;
    position: relative;
}

/* Chart bars */
.chart-bar-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    max-width: 80px;
}

.chart-bar {
    width: 100%;
    border-radius: 8px 8px 0 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 8px;
    position: relative;
    min-width: 45px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.chart-bar:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
}

.wti-value {
    color: var(--text-primary);
    font-weight: 600;
    font-size: clamp(0.75rem, 2.5vw, 0.9rem);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

.day-label {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: clamp(0.8rem, 2.5vw, 0.95rem);
}

.chart-note {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 1.5rem;
}

/* Loading and error states */
.loading-message, .error-message {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 120px;
    color: var(--text-muted);
    font-style: italic;
}

.error-message {
    color: #ff6b6b;
}

/* Features & CTA Section */
.features-cta {
    padding: 6rem 2rem;
    background: linear-gradient(180deg, var(--bg-dark) 0%, #0c1932 100%);
}

.features-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
}

.features-content h2 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
    margin-bottom: 2.5rem;
    color: var(--text-primary);
}

.tease-list {
    margin-bottom: 3rem;
    text-align: left;
}

.tease-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 0.75rem 0;
}

.tease-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
    width: 2rem;
    text-align: center;
}

.tease-item span:last-child {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
}

/* Button Styles */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    white-space: nowrap;
}

.btn-lg {
    padding: 1.25rem 2.5rem;
    font-size: 1.1rem;
    border-radius: 14px;
}

.btn-primary {
    background: linear-gradient(135deg, #eb427b, #ff6b9d);
    color: white;
    box-shadow: 0 8px 25px rgba(235, 66, 123, 0.3);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(235, 66, 123, 0.4);
    background: linear-gradient(135deg, #ff4d85, #ff7ba8);
}

.alpha-note {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 1.25rem;
    font-style: italic;
}

/* Footer */
.footer {
    border-top: 1px solid var(--border);
    padding: 3rem 2rem;
    background: var(--bg-dark);
}

.footer-content {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
}

.footer-copy {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.footer-links {
    display: flex;
    gap: 2rem;
}

.footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
}

.footer-links a:hover {
    color: var(--accent);
}

/* Mobile Responsive */
@media (max-width: 768px) {
    .hero {
        min-height: 90vh;
        padding: 3rem 1.5rem;
    }

    .chart-section {
        padding: 4rem 1.5rem;
    }

    .chart-wrapper {
        padding: 2rem 1rem 1.5rem;
    }

    .wti-chart {
        gap: 0.8rem;
        height: 200px;
    }

    .chart-bar {
        min-width: 35px;
    }

    .features-cta {
        padding: 4rem 1.5rem;
    }

    .tease-list {
        text-align: left;
    }

    .tease-item {
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .tease-icon {
        font-size: 1.1rem;
        width: 1.5rem;
    }

    .tease-item span:last-child {
        font-size: 0.95rem;
    }

    .btn-lg {
        padding: 1rem 2rem;
        font-size: 1rem;
    }

    .footer-content {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
    }
}

@media (max-width: 480px) {
    .wti-chart {
        gap: 0.5rem;
        padding: 0 0.5rem;
    }

    .chart-bar {
        min-width: 30px;
    }

    .wti-value {
        font-size: 0.7rem;
    }

    .day-label {
        font-size: 0.75rem;
    }
}

/* Subtle animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero-content {
    animation: fadeInUp 0.8s ease-out;
}

.chart-container {
    animation: fadeInUp 0.8s ease-out 0.2s both;
}

.features-content {
    animation: fadeInUp 0.8s ease-out 0.4s both;
}